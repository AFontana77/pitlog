      "ingredient_groups": [
        {
          "name": "Sauce",
          "items": [
            {
              "qty": "2 cups",
              "item": "ketchup"
            },
            {
              "qty": "1 cup",
              "item": "apple juice",
              "note": "reduced by half first, see step 1"
            },
            {
              "qty": "1/2 cup",
              "item": "fresh orange juice",
              "note": "about 2 oranges"
            },
            {
              "qty": "1/2 cup",
              "item": "packed brown sugar"
            },
            {
              "qty": "1/3 cup",
              "item": "apple cider vinegar"
            },
            {
              "qty": "3 tbsp",
              "item": "molasses"
            },
            {
              "qty": "1 tbsp",
              "item": "smoked paprika"
            },
            {
              "qty": "2 tsp",
              "item": "chipotle powder",
              "note": "1 tsp for a milder sauce"
            },
